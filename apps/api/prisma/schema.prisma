// ══════════════════════════════════════════════════════════════
// City Dental — foundation Prisma schema
//
// Scope: Phase 1–3 entity set only.
//   Organization, Location, User, Role, Permission, UserRole,
//   AuditLog, Patient, Doctor, DoctorSpecialty, Appointment
//
// Intentionally NOT defined yet (later phases):
//   clinical records, dental charting, treatment plans, billing,
//   CRM, notifications, ABDM/ABHA artifacts.
// See docs/architecture/README.md for the phased plan.
// ══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  STAFF
  PATIENT_PORTAL
  PHONE
  WALK_IN
}

enum AgeGroup {
  CHILD
  ADULT
  SENIOR
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  UPI
  UPI_QR
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  PHONEPE
  CASHFREE
  PAYU
  MOCK
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
}

// ──────────────────────────────────────────────────────────────
// Tenancy: Organization → Location
// ──────────────────────────────────────────────────────────────

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  timezone  String             @default("Asia/Kolkata")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  locations      Location[]
  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  patients       Patient[]
  doctors        Doctor[]
  appointments   Appointment[]
  communications Communication[]
  payments       Payment[]

  @@map("organizations")
}

model Location {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String         @default("India")
  phone          String?
  email          String?
  timezone       String?
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userRoles    UserRole[]
  patients     Patient[]
  doctors      Doctor[]
  appointments Appointment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("locations")
}

// ──────────────────────────────────────────────────────────────
// Users, roles, permissions
// ──────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  status        UserStatus @default(ACTIVE)
  isSuperAdmin  Boolean    @default(false)

  /// Bumped to invalidate every previously-issued refresh token.
  tokenVersion  Int        @default(0)

  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles        UserRole[]
  auditLogs    AuditLog[]
  createdAppointments Appointment[] @relation("AppointmentCreatedBy")
  doctor       Doctor?
  communications Communication[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

/// Permission is a global catalog entry (e.g. "patient:read").
/// Not tenant-scoped so permission codes stay consistent everywhere.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

/// Roles are tenant-scoped. `isSystem` roles are seeded and cannot be deleted.
model Role {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's role assignment. `locationId = null` means organization-wide.
/// Location-scoped roles are how location-level permissions are expressed.
/// onDelete: Cascade for location prevents scope escalation: deleting a location
/// removes the assignment rather than nullifying it to org-wide (see Phase 2 hardening).
model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  locationId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@unique([userId, roleId, locationId])
  @@index([userId])
  @@index([roleId])
  @@index([locationId])
  @@map("user_roles")
}

/// Append-only audit trail. Never updated or deleted by application code.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action       AuditAction
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────────────────────
// Patients, doctors, appointments
// ──────────────────────────────────────────────────────────────

model Patient {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryLocationId String?
  primaryLocation   Location?     @relation(fields: [primaryLocationId], references: [id], onDelete: SetNull)
  communications    Communication[]
  payments          Payment[]

  patientNumber String?
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        String?
  email         String?
  phone         String?
  addressLine1  String?
  city          String?
  state         String?
  postalCode    String?
  status        PatientStatus @default(ACTIVE)
  ageGroup      AgeGroup?

  /// ABDM/ABHA readiness extension point — not populated in this phase.
  abhaAddress String?
  abhaNumber  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([organizationId, status])
  @@map("patients")
}

model Doctor {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?      @unique
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryLocationId String?
  primaryLocation   Location?    @relation(fields: [primaryLocationId], references: [id], onDelete: SetNull)

  firstName      String
  lastName       String
  email          String?
  phone          String?
  licenseNumber  String?
  qualifications String?
  status         DoctorStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  specialties  DoctorSpecialty[]
  appointments Appointment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("doctors")
}

/// Configurable per-doctor specialty catalog. Dentistry has many
/// subspecialties, so the vocabulary must not be hardcoded.
model DoctorSpecialty {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  createdAt DateTime @default(now())

  @@unique([doctorId, name])
  @@index([doctorId])
  @@map("doctor_specialties")
}

// ──────────────────────────────────────────────────────────────
// Appointments
// ──────────────────────────────────────────────────────────────

model Appointment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus @default(SCHEDULED)
  source         AppointmentSource @default(STAFF)
  ageGroup       AgeGroup?
  reason         String?
  notes          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  payments Payment[]

  /// Overlap prevention: a doctor cannot hold two live appointments
  /// in the same slot. Enforced in the service layer inside a
  /// transaction (Postgres exclusion constraints are added later).
  @@index([organizationId, scheduledStart])
  @@index([organizationId, status])
  @@index([locationId, scheduledStart])
  @@index([patientId])
  @@index([doctorId, scheduledStart])
  @@map("appointments")
}

// ──────────────────────────────────────────────────────────────
// Communications (Phase 11)
// ──────────────────────────────────────────────────────────────

enum CommunicationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CommunicationStatus {
  QUEUED
  SUCCESS
  FAILED
  NOT_CONFIGURED
}

model Communication {
  id             String                @id @default(uuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String?
  patient        Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  channel        CommunicationChannel
  template       String?
  message        String?
  status         CommunicationStatus
  provider       String?
  providerMessageId String?
  failureReason  String?
  initiatedById  String?
  initiatedBy    User?                 @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  sentAt         DateTime?
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, createdAt])
  @@index([patientId])
  @@index([initiatedById])
  @@map("communications")
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod
  provider          PaymentProvider @default(MOCK)
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  providerReference String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?

  @@index([appointmentId])
  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([createdAt])
  @@map("payments")
}