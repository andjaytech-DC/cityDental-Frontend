# ══════════════════════════════════════════════════════════════
# City Dental — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ══════════════════════════════════════════════════════════════

NODE_ENV=development

# ── Applications ──────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000

# ── Database (PostgreSQL via Prisma) ──────────────────────────
DATABASE_URL=postgresql://citydental:citydental@localhost:5432/citydental?schema=public
POSTGRES_USER=citydental
POSTGRES_PASSWORD=citydental
POSTGRES_DB=citydental
POSTGRES_PORT=5432

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── Auth (generate strong random values in every environment) ─
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Frontend → API ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:3000

# ── Public site / SEO ────────────────────────────────────────
# Canonical production origin used by canonical tags, sitemap.xml, robots.txt
# and absolute Open Graph URLs. Must match the deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Website contact form ─────────────────────────────────────
# Receives enquiries submitted through /contact. Falls back to SMTP_FROM.
# Delivery also requires COMMUNICATIONS_ENABLED=true and the SMTP_* values.
CONTACT_TO_EMAIL=

# ── Optional analytics (loaded ONLY after cookie consent) ────
# NEXT_PUBLIC_ANALYTICS_PROVIDER: plausible | ga (leave empty to disable)
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_GA_ID=

# ── Object storage (S3-compatible; optional in foundation) ────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────
# required for Email CONNECTED: SMTP_HOST + SMTP_FROM + COMMUNICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=           # optional, default 587 (465 for SSL)
SMTP_USER=           # optional if no auth
SMTP_PASSWORD=       # optional if no auth
SMTP_FROM=           # required, e.g. noreply@citydental.example.com

# ── SMS provider (abstraction — none required locally) ─────────
# required for SMS CONNECTED: SMS_PROVIDER + SMS_API_KEY + COMMUNICATIONS_ENABLED=true
# optional: SMS_API_SECRET, SMS_FROM (provider-specific)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# ── WhatsApp provider (abstraction — none required locally) ────
# required for WhatsApp CONNECTED: WHATSAPP_PROVIDER + WHATSAPP_API_KEY + COMMUNICATIONS_ENABLED=true
# optional: WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Branding ─────────────────────────────────────────────────
APP_NAME=City Dental

# ── Communication safety: providers send NOTHING when false ─
# required: true to enable any Email/SMS/WhatsApp delivery
COMMUNICATIONS_ENABLED=false

# ── Payments (INR + UPI) ───────────────────────────────────────
# required for any payment: PAYMENTS_ENABLED=true + PAYMENT_PROVIDER + PAYMENT_KEY_ID + PAYMENT_KEY_SECRET
# optional: PAYMENT_WEBHOOK_SECRET, PAYMENT_CURRENCY (default INR)
# secret keys remain server-only (never NEXT_PUBLIC)
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=          # RAZORPAY | STRIPE | PHONEPE | CASHFREE | PAYU | MOCK
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# ── Required vs Optional ───────────────────────────────────────
# required: DATABASE_URL, JWT_ACCESS_SECRET (>=32), JWT_REFRESH_SECRET (>=32)
# optional dev: POSTGRES_*, REDIS_*, STORAGE_*, SMTP_*, SMS_*, WHATSAPP_*, PAYMENT_*
# production: set COMMUNICATIONS_ENABLED=true and PAYMENTS_ENABLED=true only when providers configured